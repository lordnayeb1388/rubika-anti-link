# توکن ربات از @BotFather در روبیکا (هرگز آن را در گیت‌هاب قرار ندهید)
BOT_TOKEN=

# شناسه مدیران مجاز (GUID کاربری، مثل u0xxxx) با کاما جدا شوند
ADMIN_IDS=

# مسیر فایل دیتابیس
DB_PATH=antilink.db

# وضعیت پیش‌فرض ضدلینک برای گروه‌های جدید (true/false)
DEFAULT_ENABLED=true

# پیام مدیران حتی با لینک حذف نشود (true/false)
EXEMPT_ADMINS=true

# تشخیص آدرس‌های بدون http/www مثل example.com (true/false)
BLOCK_BARE_DOMAINS=true

LOG_LEVEL=INFO
